# ==============================================================================
# TraceForge Environment Configuration
# Copy this file to .env before starting the services
# ==============================================================================

# Backend API Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# FalkorDB Database Connection
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_GRAPH_NAME=traceforge
# Optional: Credentials and TLS for hosted FalkorDB instances (leave blank/false for local default)
FALKORDB_USERNAME=
FALKORDB_PASSWORD=
FALKORDB_SSL=false

# Frontend Configuration (used by Vite)
VITE_API_BASE_URL=http://localhost:8000
